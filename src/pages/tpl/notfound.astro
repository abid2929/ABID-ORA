---
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import { t, u } from '../../lib/t';
const links: [string, string][] = [[u('home'), 'nav.home'], [u('worlds'), 'nav.worlds'], [u('founder'), 'nav.founder']];
---
<Base title="nf.meta.title" desc="nf.meta.desc" bodyClass="nf" noindex>
<Bar links={links} />
<main id="main" class="nfm">
 <svg class="ring" viewBox="0 0 100 100" aria-hidden="true"><circle class="rg" cx="50" cy="50" r="40"/><g class="od"><circle cx="78" cy="22" r="3"/></g></svg>
 <p class="mono">404</p>
 <h1 set:html={t('nf.title')}></h1>
 <p class="lead">{t('nf.text')}</p>
 <p class="acts"><a class="cta2" href={u('home')}>{t('nf.home')}</a><a class="cta2" href={u('worlds')}>{t('nf.worlds')}</a></p>
</main>
<style is:global>
.nfm{min-height:100vh;min-height:100svh;display:grid;align-content:center;justify-items:start;gap:20px;padding:120px var(--gx) 60px;position:relative;overflow:hidden}
.nfm .ring{position:absolute;inset-inline-end:-10vw;top:10vh;width:min(80vw,700px);color:var(--bone);opacity:.5;pointer-events:none}
.nfm .ring .rg{fill:none;stroke:currentColor;stroke-width:.5;stroke-dasharray:2 3}
.nfm .ring .od{fill:var(--signal);transform-origin:50px 50px;animation:orbit 30s linear infinite}
.nfm .mono{color:var(--signal)}
.nfm h1{font-family:var(--serif);font-weight:400;font-size:clamp(56px,10vw,150px);line-height:.9;letter-spacing:-.03em;max-width:12ch;position:relative}
.nfm h1 em{font-style:italic;color:var(--signal)}
.nfm .lead{max-width:48ch;color:#cfc8bc;position:relative}
.nfm .acts{display:flex;flex-wrap:wrap;gap:10px;position:relative}
.cta2{display:inline-flex;border:1px solid var(--bone);border-radius:999px;padding:14px 22px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.cta2:hover{background:var(--bone);color:var(--ink)}
@media (prefers-reduced-motion:reduce){.nfm .ring .od{animation:none}}
</style>
<script>import '../../scripts/common';</script>
</Base>
