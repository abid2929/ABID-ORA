---
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import Portrait from '../../components/Portrait.astro';
import { THEMES } from '../../data/themes';
import { CURSORS } from '../../data/cursors';
import { t, ta, u, ROOT } from '../../lib/t';
import { P30, P30_CATS } from '../../data/worlds30';
import '../../styles/home30.css';
const UVP_PIC: Record<string, string> = { fashion: 'clothing', tech: 'robotics', games: 'racing', nature: 'ocean', space: 'galaxy', arch: 'future-city', art: 'digital-art' };
const pn = (i: number) => String(i + 1).padStart(2, '0');
const whref = (w: number | 'ai') => w === 'ai' ? u('ai') : w ? `${u('world')}?w=${w}` : '';
const links: [string, string][] = [['#index', 'nav.index'], [u('worlds'), 'nav.worlds'], ['#studio', 'nav.studio'], [u('founder'), 'nav.founder']];
const groups: [string, string, [string, string][]][] = [
  ['mood', 'studio.mood', [['natural', 'js.mood.natural'], ['noir', 'js.mood.noir'], ['dusk', 'js.mood.dusk'], ['arctic', 'js.mood.arctic'], ['neon', 'js.mood.neon']]],
  ['cursor', 'studio.cursor', [['lens', 'studio.cur.lens'], ['dot', 'studio.cur.dot'], ['native', 'studio.cur.native']]],
  ['motion', 'studio.motion', [['full', 'studio.m.full'], ['calm', 'studio.m.calm']]],
  ['grain', 'studio.grain', [['on', 'studio.on'], ['off', 'studio.off']]],
  ['type', 'studio.type', [['auto', 'hs.ty.auto'], ['editorial', 'hs.ty.editorial'], ['elegant', 'hs.ty.elegant'], ['classic', 'hs.ty.classic'], ['grotesk', 'hs.ty.grotesk'], ['tech', 'hs.ty.tech'], ['neo', 'hs.ty.neo']]],
  ['fpic', 'hs.pic', [['castle-mist', 'hs.p.castle'], ['aurora', 'hs.p.aurora'], ['coast', 'hs.p.coast'], ['city-dawn', 'hs.p.city'], ['forest-mist', 'hs.p.forest']]],
  ['fside', 'hs.side', [['l', 'hs.s.l'], ['r', 'hs.s.r']]],
  ['fzoom', 'hs.zoom', [['s', 'hs.sz.s'], ['m', 'hs.sz.m'], ['l', 'hs.sz.l']]],
  ['scale', 'studio.size', [['90', 'hs.sz.s'], ['100', 'hs.sz.m'], ['115', 'hs.sz.l'], ['130', 'hs.sz.xl']]],
];
---
<Base title="meta.title" desc="meta.desc" bodyClass="home">
<canvas id="grain" aria-hidden="true"></canvas>
<div id="cur" aria-hidden="true"><span></span></div>
<div id="pre" aria-hidden="true">
 <div class="win" id="pwin"><img class="on" src={`${ROOT}assets/home/cosmos-nebula-s.webp`} alt="" fetchpriority="high" width="720" height="684"></div>
 <svg class="ora" viewBox="0 0 100 100" aria-hidden="true"><circle class="rg" cx="50" cy="50" r="38"/><g class="od"><circle cx="77" cy="23" r="9"/></g></svg>
 <div class="cnt" id="pcnt">0</div>
 <div class="lbl mono"><span>{'{brand}'}</span><br>{t('pre.loading')}</div>
</div>
<Bar links={links} contact="#contact" sound />
<main id="main">
<h1 class="vh">{t('meta.title')}</h1>
<section class="hero" id="top" aria-label={ta('a.featured')}>
 <picture><source media="(max-width:760px) and (orientation:portrait)" srcset={`${ROOT}assets/home/cosmos-nebula-p.jpg`}><img id="fallback" alt="" fetchpriority="high" src={`${ROOT}assets/home/cosmos-nebula.jpg`}></picture>
 <canvas id="gl" aria-hidden="true"></canvas>
 <div class="shade"></div>
 <div class="meta mono"><span>{t('hero.vol')}</span><b id="hmeta"></b><span id="hsrc">{t('hero.photo')}</span></div>
 <div class="ttl">
  <div class="k mono"><span id="hnum">01</span><span>/</span><span id="htot">08</span><span class="kby"><i class="kd">—&nbsp;&nbsp;</i>{t('hero.by')}</span></div>
  <p class="htitle" id="htitle" aria-live="polite"></p>
  <p class="hwhat">{t('hero.what')}</p>
  <nav class="hgo" aria-label={ta('hero.start')}>
   <a href={`${u('world')}?w=2`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l-5 4 3 3 2-1v12h8V9l2 1 3-3-5-4c0 2-2 3-4 3S8 5 8 3z"/></svg><span>{t('hero.go.clothes')}</span></a>
   <a href={u('worlds')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg><span>{t('hero.go.worlds')}</span></a>
   <a href={`${u('world')}?w=11`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9h12a4 4 0 0 1 4 4v1a3 3 0 0 1-5.4 1.8L15 14H9l-1.6 1.8A3 3 0 0 1 2 14v-1a4 4 0 0 1 4-4z"/><path d="M7 11v3M5.5 12.5h3"/></svg><span>{t('hero.go.game')}</span></a>
   <a href={u('ai')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h.01M12 10h.01M16 10h.01"/></svg><span>{t('hero.go.ai')}</span></a>
  </nav>
 </div>
 <p class="hswipe mono" aria-hidden="true"><i></i>{t('hero.swipe')}</p>
 <div class="scr mono"><i></i>{t('hero.scroll')}</div>
 <div class="ctrl"><div class="dots" id="dots" role="tablist" aria-label={ta('a.choose')}></div></div>
</section>

<section class="p3" id="worlds30" aria-labelledby="p3-h" data-mode="deck">
 <div class="p3-bg" aria-hidden="true"></div>
 <div class="p3-head">
  <span class="mono p3-lbl"><i></i>{t('p3.label')}</span>
  <h2 id="p3-h" set:html={t('p3.title')}></h2>
  <p class="p3-txt">{t('p3.text')}</p>
 </div>
 <div class="p3-cats" role="group" aria-label={ta('p3.label')}>
  <button type="button" class="p3-cat mono" data-c="all" aria-pressed="true">{t('p3.all')}<sup>{P30.length}</sup></button>
  {P30_CATS.map((c) => <button type="button" class="p3-cat mono" data-c={c} aria-pressed="false">{t('p3.c.' + c)}<sup>{P30.filter((w) => w.cat === c).length}</sup></button>)}
 </div>
 <div class="p3-stage">
  <canvas class="p3-gl" aria-hidden="true"></canvas>
  <ol class="p3-deck">
   {P30.map((w, i) => { const h = whref(w.w) + (w.tab ? '#' + w.tab : ''); const inner = <Fragment>
     <figure class="p3-ph"><img src={`${ROOT}assets/p30/${w.k}.webp`} srcset={`${ROOT}assets/p30/${w.k}-s.webp 480w, ${ROOT}assets/p30/${w.k}-m.webp 640w, ${ROOT}assets/p30/${w.k}.webp 960w`} sizes="(max-width:820px) 72vw, 300px" width="960" height="1280" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" alt=""><span class="p3-sheen"></span></figure>
     <span class="p3-cap"><span class="mono p3-no">{pn(i)}<span class="p3-ncat"> · {t('p3.c.' + w.cat)}</span></span><b class="p3-nm">{t('p3.n.' + w.k)}</b><span class="p3-ds">{t('p3.d.' + w.k)}</span><span class="mono p3-st">{h ? t('p3.open') : t('p3.soon')}<em>{t('p3.batch')} {w.batch}</em></span></span></Fragment>;
    return <li class={`p3-card${h ? '' : ' soon'}`} data-i={i} data-c={w.cat} data-k={w.k} style={`--tint:${w.tint}`}>{h ? <a class="p3-link" href={h}>{inner}</a> : <div class="p3-link" tabindex="0" role="group" aria-label={ta('p3.n.' + w.k)}>{inner}</div>}</li>; })}
  </ol>
  <div class="p3-info" aria-hidden="true">
   <span class="mono p3-ino"></span><b class="p3-inm"></b><span class="p3-ids"></span>
   <span class="p3-iact"><a class="p3-go mono" href="#">{t('p3.enter')} <span aria-hidden="true">→</span></a><span class="mono p3-ist"></span></span>
  </div>
  <button type="button" class="p3-arw p3-prev" aria-label={ta('p3.prev')}><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></button>
  <button type="button" class="p3-arw p3-next" aria-label={ta('p3.next')}><svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
 </div>
 <div class="p3-foot">
  <p class="mono p3-hint"><span class="p3-hd">{t('p3.hint')}</span><span class="p3-hm">{t('p3.hintm')}</span></p>
  <div class="p3-dots" aria-hidden="true"><i></i></div>
  <button type="button" class="p3-view mono" aria-pressed="false"><span class="p3-vg">{t('p3.grid')}</span><span class="p3-vd">{t('p3.deck')}</span></button>
 </div>
</section>

<section class="uvp" id="sky" aria-labelledby="uv-h">
 <div class="uvp-head rv"><span class="mono">{t('uv.label')}</span><h2 id="uv-h" set:html={t('uv.title')}></h2><p>{t('uvp.text')}</p></div>
 <ul class="uvp-grid">
  {P30_CATS.map((c, i) => { const ws = P30.filter((w) => w.cat === c); const k = UVP_PIC[c]; return <li class={`uvp-c uvp-${i}`} style={`--tint:${ws[0].tint}`}><a href={`${u('worlds')}#a30-${c}`}>
   <img src={`${ROOT}assets/p30/${k}.webp`} srcset={`${ROOT}assets/p30/${k}-s.webp 480w, ${ROOT}assets/p30/${k}-m.webp 640w, ${ROOT}assets/p30/${k}.webp 960w`} sizes={i === 0 ? '(max-width:820px) 100vw, 50vw' : '(max-width:820px) 50vw, 25vw'} width="960" height="1280" loading="lazy" decoding="async" alt="">
   <span class="uvp-cap"><span class="mono uvp-n">{ws.length} {t('uvp.n')}</span><b>{t('p3.c.' + c)}</b><span class="uvp-ws">{ws.map((w) => t('p3.n.' + w.k)).join(' · ')}</span><span class="mono uvp-go">{t('uvp.go')} <span aria-hidden="true">→</span></span></span>
  </a></li>; })}
 </ul>
 <div class="uv-tools"><button type="button" class="uv-listbtn mono" aria-expanded="false" aria-controls="uv-list" data-show={ta('uvp.all')} data-hide={ta('uvp.hide')}>{t('uvp.all')}</button></div>
 <nav class="uv-list" id="uv-list" aria-label={ta('uv.listLabel')} hidden set:html="{{UNIVERSE_LIST}}"></nav>
</section>

<section class="dsc" id="discover" aria-labelledby="dsc-h" hidden>
 <div class="dsc-head"><span class="mono">{t('js.dsc.label')}</span><h2 id="dsc-h" set:html={t('js.dsc.title')}></h2><p class="mono dsc-prog"></p></div>
 <div class="dsc-grid">
  <article class="dsc-col"><h3 class="mono">{t('js.dsc.today')}</h3><p class="dsc-note">{t('js.dsc.todaynote')}</p><div class="dsc-today"></div></article>
  <article class="dsc-col"><h3 class="mono">{t('js.dsc.guide')}</h3><p class="dsc-note">{t('js.dsc.guideq')}</p>
   <div class="dsc-moods" role="group" aria-label={ta('js.dsc.guideq')}>
    <button type="button" class="dsc-mood" data-m="make" aria-pressed="false">{t('js.dsc.m.make')}</button>
    <button type="button" class="dsc-mood" data-m="learn" aria-pressed="false">{t('js.dsc.m.learn')}</button>
    <button type="button" class="dsc-mood" data-m="play" aria-pressed="false">{t('js.dsc.m.play')}</button>
    <button type="button" class="dsc-mood" data-m="earth" aria-pressed="false">{t('js.dsc.m.earth')}</button>
    <button type="button" class="dsc-mood" data-m="look" aria-pressed="false">{t('js.dsc.m.look')}</button>
   </div>
   <div class="dsc-picks" aria-live="polite" hidden></div><button type="button" class="dsc-more mono" hidden>{t('js.dsc.more')}</button></article>
  <article class="dsc-col"><h3 class="mono">{t('js.dsc.surprise')}</h3><p class="dsc-note">{t('js.dsc.surprisenote')}</p><button type="button" class="dsc-sbtn">{t('js.dsc.surprise')}</button><div class="dsc-sout" aria-live="polite" hidden></div></article>
 </div>
</section>

<section class="mani" aria-label={ta('a.manifesto')}>
 <div class="mono"><span>{t('mani.label')}</span><span>{'{brand}'}</span></div>
 <div class="mpin"><p id="mp" set:html={t('mani.text')}></p></div>
 <div class="foot">
  <div class="rv"><b>{t('mani.one.h')}</b><span>{t('mani.one.t')}</span></div>
  <div class="rv"><b>{t('mani.every.h')}</b><span>{t('mani.every.t')}</span></div>
  <div class="rv"><b>{t('mani.yours.h')}</b><span>{t('mani.yours.t')}</span></div>
 </div>
 <!-- real counts: worlds come from the site data at publish time, themes and cursors from the studio lists -->
 <div class="nums rv" aria-labelledby="nums-h">
  <div class="mono" id="nums-h">{t('num.label')}</div>
  <dl>
   <div><dt>{t('num.live')}</dt><dd data-n="{{N_LIVE}}">{'{{N_LIVE}}'}</dd></div>
   <div><dt>{t('num.total')}</dt><dd data-n="{{N_TOTAL}}">{'{{N_TOTAL}}'}</dd></div>
   <div><dt>{t('num.themes')}</dt><dd data-n={THEMES.length}>{THEMES.length}</dd></div>
   <div><dt>{t('num.cursors')}</dt><dd data-n={CURSORS.length}>{CURSORS.length}</dd></div>
   <div><dt>{t('num.langs')}</dt><dd data-n="{{N_LANGS}}">{'{{N_LANGS}}'}</dd></div>
  </dl>
 </div>
</section>

<section class="atlas" id="index" aria-label={ta('a.index')}>
 <div class="sh rv"><h2 set:html={t('idx.title')}></h2><p>{t('idx.text')} <a class="ul" href={u('worlds')}>{t('idx.all')}</a></p></div>
 <ul class="idx" id="idx"></ul>
</section>

<section class="reel" id="reel" aria-label={ta('a.reel')}>
 <div class="stick">
  <div class="hd mono"><span>{t('reel.label')}</span><span id="rc">01 / 10</span></div>
  <div class="track" id="track"></div>
  <div class="bar2"><i id="rbar"></i></div>
 </div>
</section>

<section class="studio" id="studio" aria-label={ta('a.studio')}>
 <div class="frame rv"><img id="fimg" src={`${ROOT}assets/home/castle-mist.jpg`} srcset={`${ROOT}assets/home/castle-mist-s.jpg 720w, ${ROOT}assets/home/castle-mist.jpg 1600w`} sizes="(max-width:800px) 92vw, 40vw" loading="lazy" decoding="async" alt={ta('studio.alt')}><div class="duo" id="fduo"></div><div class="tag mono"><span>{t('studio.preview')}</span><span id="fmood"></span></div></div>
 <div class="ctl rv">
  <span class="mono" style="color:var(--mute)">{t('studio.label')}</span>
  <h2 style="margin-top:14px" set:html={t('studio.title')}></h2>
  <p>{t('studio.text')}</p>
  {groups.map(([k, lab, vals]) => <div class={`grp grp-${k}`}><span class="mono">{t(lab)}</span><div class="seg" data-k={k}>{vals.map(([v, key]) => <button data-v={v} type="button">{t(key)}</button>)}</div></div>)}
  <div class="stl"><a class="mono" href={u('themes')}>{t('th.open')} →</a><a class="mono" href={u('cursors')}>{t('cu.open')} →</a><a class="mono" href={u('studio')}>{t('us.open')} →</a></div>
 </div>
</section>

<section class="hf" id="founder" aria-labelledby="hf-h">
 <div class="hf-pic rv"><Portrait sizes="(max-width:800px) 92vw, 46vw" /></div>
 <div class="hf-txt rv">
  <span class="mono hf-lbl">{t('hf.label')}</span>
  <h2 id="hf-h">{'{owner}'}</h2>
  <p class="hf-role">{t('fd.title')}</p>
  <p class="hf-id mono"><span>{t('fd.id1')}</span><span>{t('fd.id2')}</span></p>
  <blockquote class="hf-tag"><p>{t('fd.tagline')}</p></blockquote>
  <a class="hf-cta" href={u('founder')}>{t('hf.more')} <span aria-hidden="true">→</span></a>
 </div>
</section>
</main>

<footer id="contact">
 <div class="ct">
  <div class="cth"><span class="mono">{t('ct.label')}</span><h2 set:html={t('ct.title')}></h2><p>{t('ct.text')}</p></div>
  <form id="cf" action={`${ROOT}api/contact.php`} method="post" novalidate>
   <label for="cf-n" class="mono">{t('ct.name')}</label><input id="cf-n" name="name" autocomplete="name" required maxlength="80">
   <label for="cf-e" class="mono">{t('ct.email')}</label><input id="cf-e" name="email" type="email" autocomplete="email" required maxlength="120">
   <label for="cf-m" class="mono">{t('ct.msg')}</label><textarea id="cf-m" name="message" rows="4" required maxlength="3000"></textarea>
   <input name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true">
   <input type="hidden" name="lang" value="{{LANGCODE}}">
   <div class="cfr"><button type="submit" class="mono sendb">{t('ct.send')}</button><p id="cf-s" class="mono" role="status" aria-live="polite"></p></div>
  </form>
 </div>
 <div class="mq mono" aria-hidden="true"><div id="mqt"></div></div>
 <div class="big" aria-hidden="true"><span class="brand-w">{'{brand}'}</span></div>
 <nav class="fnav mono" aria-label={ta('a.footer')}><a href="#index">{t('nav.index')}</a><a href={u('worlds')}>{t('nav.worlds')}</a><a href="#studio">{t('nav.studio')}</a><a href={u('founder')}>{t('nav.founder')}</a><a href={u('credits')}>{t('ft.credits')}</a></nav>
 <div class="fl mono"><span>© <span class="yr"></span> {t('ft.owner')}</span><span>{t('ft.photo')} · <a href={u('credits')} style="text-decoration:underline">{t('ft.credits')}</a></span><a href="#top">{t('ft.top')}</a></div>
</footer>
<script>import '../../scripts/home';</script>
</Base>
