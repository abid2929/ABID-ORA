---
/* Shared page shell. Everything in {{ }} is filled per language by the PHP renderer. */
import '../styles/abidora.css';
import '../styles/future.css';
import { t, ta } from '../lib/t';
import qHead from '../scripts/quality-head.min.js?raw'; /* source: quality-head.js */
import vtHead from '../scripts/vt-head.min.js?raw'; /* source: vt-head.js (npx esbuild src/scripts/vt-head.js --minify --outfile=src/scripts/vt-head.min.js) */
interface Props { title: string; desc: string; bodyClass?: string; noindex?: boolean }
const { title, desc, bodyClass = '', noindex = false } = Astro.props;
const icon = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' fill='%230d0c0b'/><circle cx='30' cy='34' r='17' fill='none' stroke='%23ece6dc' stroke-width='6'/><circle cx='42' cy='22' r='6' fill='%23e8b46a'/></svg>";
---
<html lang="{{LANG}}" dir="{{DIR}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title set:html={ta(title)}></title>
<meta name="description" content={ta(desc)}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0d0c0b">
<link rel="icon" href={icon}>
<Fragment set:html="{{HEAD}}" />
<script is:inline>try{history.scrollRestoration="manual"}catch(e){}if(!location.hash){scrollTo(0,0);addEventListener("load",function(){if(!location.hash)scrollTo(0,0)})}</script>
<script is:inline set:html={qHead}></script>
<script is:inline set:html={vtHead}></script>
<slot name="head" />
<Fragment set:html="<style>{{LANGCSS}}</style>" />
</head>
<body class={bodyClass}>
<div id="vtp" aria-hidden="true"></div>
<a class="skip" href="#main">{t('a.skip')}</a>
<slot />
<Fragment set:html="{{RUNTIME}}" />
</body>
</html>
